# anneau.js sans argument écrit ses captures dans « undefined/ » : c'est du
# jetable de banc d'essai, jamais du dépôt.
undefined/

# Les bancs nomment leur dossier d'images d'après l'URL qu'on leur donne :
# lancés sur une adresse de labo, ils créaient « http:/127.0.0.1:8096/… ».
# Ce sont des images de travail, jamais du jeu.
http:/

# Le relevé des 1545 questions, sorti par banc-essai/ pour les analyses :
